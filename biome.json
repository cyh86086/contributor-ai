{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "includes": [
      "**",
      "!scripts/autojs6/d01-jpeg-device-check.js",
      "!scripts/autojs6/d02-png-device-check.js",
      "!scripts/autojs6/d03-webp-device-check.js",
      "!scripts/autojs6/d04-heic-device-check.js",
      "!scripts/autojs6/d05-heif-device-check.js",
      "!scripts/autojs6/d06-resolver-mime-device-check.js",
      "!scripts/autojs6/d07-mime-fallback-device-check.js",
      "!scripts/autojs6/d08-permission-granted-device-check.js",
      "!scripts/autojs6/d13-exact-portable-limit-device-check.js",
      "!scripts/autojs6/d14-portable-size-overflow-device-check.js",
      "!scripts/autojs6/d15-reader-safety-ceiling-overflow-device-check.js",
      "!scripts/autojs6/d16-repeated-reads-device-check.js",
      "!scripts/autojs6/d17-multi-image-sequential-device-check.js",
      "!scripts/autojs6/d18-stream-cleanup-success-device-check.js",
      "!scripts/autojs6/d19-cleanup-after-failure-device-check.js",
      "!scripts/autojs6/d20-memory-behavior-device-check.js",
      "!scripts/autojs6/d21-ui-responsiveness-device-check.js",
      "!scripts/autojs6/d22-no-persistence-device-check.js",
      "!scripts/autojs6/d23-sensitive-logging-device-check.js",
      "!scripts/autojs6/d24-empty-image-device-check.js",
      "!scripts/autojs6/d25-unsupported-mime-type-device-check.js",
      "!scripts/autojs6/d26-controlled-encoding-failure-device-check.js",
      "!scripts/autojs6/production.js",
      "!scripts/autojs6/autojs6-remote-downloader.js"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useOptionalChain": "off"
      },
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error", "info", "warn"]
          }
        }
      }
    }
  }
}
